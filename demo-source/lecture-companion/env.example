# Madar Lecture Companion — Environment Variables
# Copy this file to `.env` and fill in your values.
# On Render/Railway, set these in the dashboard instead.

# ──────────────────────────────────────────────────────────────────
# REQUIRED for deployment
# ──────────────────────────────────────────────────────────────────

# The public URL students will open in their browser.
# Used for the ChatGPT OAuth callback redirect_uri.
# Example: https://madar-yourname.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Accept requests from any origin (needed when deployed — students' browsers
# come from your domain, not from 127.0.0.1). Set to "1" for deployment.
ALLOW_ANY_ORIGIN=1

# Bind to all network interfaces so the server is reachable.
HOST=0.0.0.0

# Port (Render/Railway set this automatically — don't hardcode in production)
PORT=3000

# ──────────────────────────────────────────────────────────────────
# REQUIRED for cloud transcription (replaces local Whisper)
# ──────────────────────────────────────────────────────────────────

# Get a free key at https://console.groq.com/keys
# Free tier: ~8 hours of audio per day, 25 MB per file (we auto-split larger ones).
GROQ_API_KEY=gsk_your_key_here

# Optional: which Whisper model Groq should use (default: whisper-large-v3)
# GROQ_WHISPER_MODEL=whisper-large-v3

# ──────────────────────────────────────────────────────────────────
# OPTIONAL — Supabase Storage (required for Vercel to handle large files)
# ──────────────────────────────────────────────────────────────────

# Get these from https://supabase.com/dashboard → your project → Settings → API
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJxxxx...

# Create a bucket named "lectures" in Supabase Dashboard → Storage.
# Make it public (or set RLS policies to allow anon uploads).

# Override Gemini base URL (useful for testing with a mock server)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Base retry delay for transient provider errors (default: 1500ms)
# GEMINI_RETRY_BASE_MS=1500

# Timeout for provider API calls (default: 120000ms = 2 minutes)
# PROVIDER_TIMEOUT_MS=120000

# Path to ffmpeg binary (auto-detected from PATH if not set)
# FFMPEG_PATH=/usr/bin/ffmpeg

# ──────────────────────────────────────────────────────────────────
# LOCAL DEV ONLY (do NOT set these in production)
# ──────────────────────────────────────────────────────────────────

# Path to a bundled Python executable (Windows .venv). If not set, we use `python` from PATH.
# PYTHON=.venv/Scripts/python.exe
